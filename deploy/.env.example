# Öffentliche Adresse des Servers (für Herkunftsprüfung und SideStore-Quelle)
SENTINEL_PUBLIC_URL=https://sentinel.example.org
# Zufallswert, mindestens 32 Zeichen: openssl rand -base64 48
SENTINEL_DATA_KEY=
# Zufallswert für den Upload neuer App-Versionen aus der Build-Pipeline (GitHub-Secret SENTINEL_DEPLOY_TOKEN)
SENTINEL_DEPLOY_TOKEN=
# Optional: Datenordner von Argus Predict (wird nur lesend eingebunden)
ARGUS_DATA_DIR=/volume1/docker/argus-predict/data


# Verkehrslage, Sperrungen und Stau-Umfahrung in der Navigation (TomTom, developer.tomtom.com). Gilt serverseitig für alle Nutzer.
SENTINEL_TOMTOM_KEY=
# Optional: zusätzliche Straßenbilder von Mapillary (Client-Token „MLY|…“ aus mapillary.com/dashboard/developers). Ohne Token nur Panoramax.
SENTINEL_MAPILLARY_TOKEN=
